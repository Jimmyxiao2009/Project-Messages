<Page
    x:Class="Yanshuai.Messages.Ui.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Yanshuai.Messages.Ui"
    Background="{StaticResource BgBrush}">

  <!-- W10M 根 Pivot、虚拟化时间线与独立功能页导航。 -->

  <Page.Resources>

    <!-- ═══ 会话卡片：三行 + 左侧 4px 色条 ═══ -->
    <DataTemplate x:Key="ConversationTemplate">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="4" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{Binding ToneBrush}" Margin="0,6,0,6" />

        <StackPanel Grid.Column="1" Margin="12,0,14,0" Padding="0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Title}"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="15" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" Style="{StaticResource SubText}" />
          </Grid>
          <TextBlock Text="{Binding Preview}" Style="{StaticResource SubText}" Margin="0,3,0,0" />
          <TextBlock Text="{Binding StatusText}"
                     Foreground="{StaticResource MidBrush}"
                     FontSize="11.5" Margin="0,5,0,0" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- ═══ 档案行 ═══ -->
    <DataTemplate x:Key="ProfileTemplate">
      <Grid MinHeight="{StaticResource RowHeight}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{StaticResource AccentSoftBrush}" Margin="12,0,12,0">
          <Grid>
            <ui:WorkspaceImage SourcePath="{Binding AvatarPath}" Visibility="{Binding AvatarVisibility}" Stretch="UniformToFill" Circular="True" />
            <TextBlock Text="{Binding Initial}" Visibility="{Binding InitialVisibility}" Foreground="{StaticResource AccentTextBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Padding="0,10">
          <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                     FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubText}" Margin="0,2,0,0" />
        </StackPanel>

        <TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource Glyph}"
                   Foreground="{StaticResource FaintBrush}" FontSize="12" Margin="0,0,14,0" />
      </Grid>
    </DataTemplate>

    <!-- ═══ 过程轨道里的一个步骤 ═══ -->
    <DataTemplate x:Key="StepTemplate">
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="{Binding NodeCornerRadius}"
                Background="{Binding NodeBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />

        <StackPanel Grid.Column="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{StaticResource StepTitle}" />
            <TextBlock Grid.Column="1" Text="{Binding StatusGlyph}"
                       FontFamily="{StaticResource IconFont}" FontSize="12"
                       Foreground="{Binding StatusBrush}" Margin="6,0,0,0" />
          </Grid>
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource StepSub}"
                     Visibility="{Binding SubtitleVisibility}" />
          <TextBlock Text="{Binding Body}" Style="{StaticResource StepBody}"
                     Visibility="{Binding BodyVisibility}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- ═══ 时间线：用户消息（唯一靠右的气泡） ═══ -->
    <DataTemplate x:Key="UserRowTemplate">
      <StackPanel Margin="0,6,0,14">
        <ui:AttachmentStrip Items="{Binding Attachments}" Visibility="{Binding AttachVisibility}" Margin="0,0,0,6" />
        <Border Style="{StaticResource UserBubble}" Background="{Binding UserBrush}">
          <TextBlock Text="{Binding Text}" Style="{StaticResource UserBubbleText}" Foreground="{Binding UserForeground}" FontSize="{Binding FontSize}" LineHeight="{Binding LineHeight}" />
        </Border>
        <Polygon Fill="{Binding UserBrush}" Points="0,0 8,0 8,8" Width="8" Height="8" HorizontalAlignment="Right" Margin="0,-1,0,0" />
      </StackPanel>
    </DataTemplate>

    <!-- ═══ 时间线：过程轨道 ═══ -->
    <DataTemplate x:Key="ProcessRowTemplate">
      <StackPanel Margin="0,2,0,12">
        <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="44" Click="ProcessSummary_Click"><Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding StateGlyph}"
                     FontFamily="{StaticResource IconFont}" FontSize="13"
                     Foreground="{Binding StateBrush}" Margin="2,0,6,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Summary}"
                     Style="{StaticResource SubText}" VerticalAlignment="Center" />
        </Grid></Button>

        <Border Style="{StaticResource RailBorder}" Visibility="{Binding RailVisibility}">
          <ItemsControl ItemsSource="{Binding StepItems}" ItemTemplate="{StaticResource StepTemplate}" />
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- ═══ 时间线：最终输出（无气泡，正文） ═══ -->
    <DataTemplate x:Key="OutputRowTemplate">
      <RichTextBlock ui:MarkdownBlock.Text="{Binding Text}" ui:MarkdownBlock.QuoteColor="{Binding QuoteColor}" ui:MarkdownBlock.BracketColor="{Binding BracketColor}" Foreground="{StaticResource TextBrush}" FontSize="{Binding FontSize}" LineHeight="{Binding LineHeight}" IsTextSelectionEnabled="True" Margin="2,0,2,16" />
    </DataTemplate>

    <!-- ═══ 时间线：居中提示 ═══ -->
    <DataTemplate x:Key="MarkerRowTemplate">
      <TextBlock Text="{Binding Text}" Style="{StaticResource SubText}"
                 HorizontalAlignment="Center" Margin="0,4,0,14" />
    </DataTemplate>

    <!-- ═══ 时间线：错误（左侧红条） ═══ -->
    <DataTemplate x:Key="ErrorRowTemplate">
      <Border BorderBrush="{StaticResource ErrBrush}" BorderThickness="2,0,0,0"
              Background="{StaticResource ChromeLowBrush}" Padding="12,9" Margin="0,2,0,14">
        <StackPanel>
          <TextBlock Text="{Binding Text}" Foreground="{StaticResource ErrTextBrush}"
                     FontSize="14" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
          <TextBlock Text="{Binding ErrorCode}" Style="{StaticResource SubText}" Margin="0,4,0,0"
                     Visibility="{Binding ErrorCodeVisibility}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <ui:TimelineTemplateSelector x:Key="TimelineSelector"
        UserTemplate="{StaticResource UserRowTemplate}"
        ProcessTemplate="{StaticResource ProcessRowTemplate}"
        OutputTemplate="{StaticResource OutputRowTemplate}"
        MarkerTemplate="{StaticResource MarkerRowTemplate}"
        ErrorTemplate="{StaticResource ErrorRowTemplate}" />

  </Page.Resources>

  <Grid>
    <!-- ═════════════════════ 首页 ═════════════════════ -->
    <Grid x:Name="HomeView">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- 顶栏 -->
      <Grid Grid.Row="0" Height="{StaticResource TopBarHeight}" Background="{StaticResource BgBrush}">
        <StackPanel VerticalAlignment="Center" Margin="12,0">
          <TextBlock Text="言枢" Foreground="{StaticResource TextBrush}"
                     FontSize="15" FontWeight="SemiBold" />
          <TextBlock x:Name="HomeSubtitle" Style="{StaticResource SubText}" FontSize="11" />
        </StackPanel>
      </Grid>

      <Pivot Grid.Row="1" x:Name="HomePivot" SelectionChanged="HomePivot_SelectionChanged"
             Background="{StaticResource BgBrush}">
        <Pivot.HeaderTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="{StaticResource FontSizeHeader}" FontWeight="Light" /></DataTemplate></Pivot.HeaderTemplate>

        <!-- ─── 对话 ─── -->
        <PivotItem Header="对话">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchBox" Grid.Row="0" Visibility="Collapsed"
                     Margin="14,8,14,4" PlaceholderText="搜索会话"
                     Background="{StaticResource ChromeMidBrush}"
                     Foreground="{StaticResource TextBrush}"
                     BorderThickness="0" FontSize="14" Padding="10,8"
                     TextChanged="SearchBox_TextChanged" />

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"><StackPanel x:Name="ProfileFilterPanel" Orientation="Horizontal" Margin="12,0,12,6" /></ScrollViewer>
            <ListView x:Name="ConversationList" Grid.Row="2"
                      ItemTemplate="{StaticResource ConversationTemplate}"
                      IsItemClickEnabled="True" ItemClick="ConversationList_ItemClick"
                      SelectionMode="None" ShowsScrollingPlaceholders="False">
              <ListView.GroupStyle>
                <GroupStyle><GroupStyle.HeaderTemplate><DataTemplate>
                  <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" />
                </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle>
              </ListView.GroupStyle>
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="MinHeight" Value="0" />
                </Style>
              </ListView.ItemContainerStyle>
            </ListView>

            <TextBlock x:Name="EmptyConversations" Grid.Row="2"
                       Text="还没有会话。点下面的「新建会话」开始。"
                       Style="{StaticResource SubText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" Margin="40,0" Visibility="Collapsed" />
          </Grid>
        </PivotItem>

        <!-- ─── 档案 ─── -->
        <PivotItem Header="档案">
          <Grid>
            <ListView x:Name="ProfileList" ItemTemplate="{StaticResource ProfileTemplate}"
                      IsItemClickEnabled="True" ItemClick="ProfileList_ItemClick"
                      SelectionMode="None" ShowsScrollingPlaceholders="False">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="MinHeight" Value="0" />
                </Style>
              </ListView.ItemContainerStyle>
            </ListView>

            <TextBlock x:Name="EmptyProfiles" Text="还没有档案。点下面的「新建档案」，或导入一张角色卡。"
                       Style="{StaticResource SubText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" Margin="40,0" Visibility="Collapsed" />
          </Grid>
        </PivotItem>

        <!-- ─── 我的 ─── -->
        <PivotItem Header="我的">
          <ScrollViewer>
            <StackPanel Padding="0,8,0,24">
              <TextBlock Text="模型与能力" Style="{StaticResource SectionLabel}" />

              <Button Style="{StaticResource RowButton}" Click="ApiProfiles_Click">
                <StackPanel>
                  <TextBlock Text="Provider 与模型" Foreground="{StaticResource TextBrush}" FontSize="15" />
                  <TextBlock x:Name="ApiProfilesSubtitle" Style="{StaticResource SubText}" />
                </StackPanel>
              </Button>

              <Button Style="{StaticResource RowButton}" Click="SearchSettings_Click">
                <StackPanel>
                  <TextBlock Text="联网搜索" Foreground="{StaticResource TextBrush}" FontSize="15" />
                  <TextBlock x:Name="SearchSubtitle" Style="{StaticResource SubText}" />
                </StackPanel>
              </Button>

              <Button Style="{StaticResource RowButton}" Click="Permissions_Click">
                <StackPanel>
                  <TextBlock Text="权限记录" Foreground="{StaticResource TextBrush}" FontSize="15" />
                  <TextBlock x:Name="PermissionsSubtitle" Style="{StaticResource SubText}" />
                </StackPanel>
              </Button>

              <TextBlock Text="数据" Style="{StaticResource SectionLabel}" />

              <Button Style="{StaticResource RowButton}" Click="Storage_Click">
                <StackPanel>
                  <TextBlock Text="存储空间" Foreground="{StaticResource TextBrush}" FontSize="15" />
                  <TextBlock x:Name="StorageSubtitle" Style="{StaticResource SubText}" />
                </StackPanel>
              </Button>

              <Button Style="{StaticResource RowButton}" Click="Backup_Click">
                <StackPanel>
                  <TextBlock Text="备份与恢复" Foreground="{StaticResource TextBrush}" FontSize="15" />
                  <TextBlock Text="打包成 zip 保存到设备，或从备份恢复" Style="{StaticResource SubText}" />
                </StackPanel>
              </Button>

              <Button Style="{StaticResource RowButton}" Click="QuickMessages_Click">
                <StackPanel>
                  <TextBlock Text="快捷消息" Foreground="{StaticResource TextBrush}" FontSize="15" />
                  <TextBlock x:Name="QuickMessagesSubtitle" Style="{StaticResource SubText}" />
                </StackPanel>
              </Button>

              <TextBlock Text="个人与外观" Style="{StaticResource SectionLabel}" />
              <Button Style="{StaticResource RowButton}" Content="用户人设" Tag="user-personas" Click="PageLink_Click" />
              <Button Style="{StaticResource RowButton}" Content="通用设置" Tag="general" Click="PageLink_Click" />
              <Button Style="{StaticResource RowButton}" Content="主题与强调色" Tag="appearance" Click="PageLink_Click" />
              <Button Style="{StaticResource RowButton}" Content="文字与可读性" Tag="typography" Click="PageLink_Click" />
              <TextBlock Text="工具与提示词" Style="{StaticResource SectionLabel}" />
              <Button Style="{StaticResource RowButton}" Content="全部内置工具" Tag="tools" Click="PageLink_Click" />
              <Button Style="{StaticResource RowButton}" Content="MCP 服务器" Tag="mcp" Click="PageLink_Click" />
              <Button Style="{StaticResource RowButton}" Content="技能" Tag="skills" Click="PageLink_Click" />
              <Button Style="{StaticResource RowButton}" Content="世界书" Tag="lorebooks" Click="PageLink_Click" />
              <Button Style="{StaticResource RowButton}" Content="模式注入" Tag="injections" Click="PageLink_Click" />
              <Button Style="{StaticResource RowButton}" Content="正则转换器" Tag="regex" Click="PageLink_Click" />
              <Button Style="{StaticResource RowButton}" Content="全局记忆" Tag="memory" Click="PageLink_Click" />
              <Button Style="{StaticResource RowButton}" Content="授权目录" Tag="folders" Click="PageLink_Click" />
              <Button Style="{StaticResource RowButton}" Content="回收区" Tag="trash" Click="PageLink_Click" />
              <Button Style="{StaticResource RowButton}" Content="数据导入与导出" Tag="data" Click="PageLink_Click" />
              <TextBlock Text="关于" Style="{StaticResource SectionLabel}" />

              <Button Style="{StaticResource RowButton}" Click="DebugLog_Click">
                <StackPanel>
                  <TextBlock Text="调试日志" Foreground="{StaticResource TextBrush}" FontSize="15" />
                  <TextBlock Text="不含密钥与正文，可复制" Style="{StaticResource SubText}" />
                </StackPanel>
              </Button>

              <Button Style="{StaticResource RowButton}" Click="About_Click">
                <StackPanel>
                  <TextBlock Text="关于言枢" Foreground="{StaticResource TextBrush}" FontSize="15" />
                  <TextBlock x:Name="AboutSubtitle" Style="{StaticResource SubText}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </ScrollViewer>
        </PivotItem>
      </Pivot>

      <!-- 底部命令区：只放 3 个，UWP 的 CommandBar 主命令不会自动溢流，超了会被裁掉 -->
      <CommandBar Grid.Row="2" Background="{StaticResource ChromeBrush}">
        <AppBarButton x:Name="NewConversationButton" Icon="Add" Label="新建会话" Click="NewConversation_Click" />
        <AppBarButton Icon="Import" Label="导入角色卡" Click="ImportCard_Click" />
        <AppBarButton Icon="Find" Label="搜索" Click="SearchToggle_Click" />
        <CommandBar.SecondaryCommands>
          <AppBarButton Icon="Contact" Label="新建档案" Click="NewProfile_Click" />
          <AppBarButton Label="批量管理" Tag="manage" Click="PageLink_Click" />
          <AppBarButton Label="已归档会话" Tag="archived" Click="PageLink_Click" />
        </CommandBar.SecondaryCommands>
      </CommandBar>
    </Grid>

    <!-- ═════════════════════ 会话页 ═════════════════════ -->
    <Grid x:Name="ChatView" Visibility="Collapsed" Background="{StaticResource BgBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ui:WorkspaceImage x:Name="ChatBackgroundImage" Grid.RowSpan="4" Stretch="UniformToFill" IsHitTestVisible="False" />

      <!-- 顶栏 -->
      <Grid Grid.Row="0" Height="{StaticResource TopBarHeight}" Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Style="{StaticResource IconButton}" Content="&#xE72B;"
                Click="ChatBack_Click" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
          <TextBlock x:Name="ChatTitle" Foreground="{StaticResource TextBrush}"
                     FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <Button Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0" MinWidth="0"
                  HorizontalAlignment="Left" Click="ChatModel_Click" AutomationProperties.Name="切换 Provider 与模型">
            <TextBlock x:Name="ChatSubtitle" Style="{StaticResource SubText}" FontSize="12" TextTrimming="CharacterEllipsis" />
          </Button>
        </StackPanel>

        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE712;"
                Click="ChatMore_Click" />
      </Grid>

      <!-- 待处理条：审批与追问固定钉在这里，不进列表 -->
      <Border x:Name="NoticeBanner" Grid.Row="1" Visibility="Collapsed"
              Background="{StaticResource WarnSoftBrush}" BorderBrush="{StaticResource WarnBrush}"
              BorderThickness="3,0,0,0" Padding="12,9">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock x:Name="NoticeTitle" Text="等待你处理"
                       Foreground="{StaticResource WarnTextBrush}" FontSize="13.5" FontWeight="SemiBold" />
            <TextBlock x:Name="NoticeDetail" Style="{StaticResource SubText}" />
          </StackPanel>
          <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Content="处理"
                  Click="NoticeAction_Click" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- 时间线 -->
      <ListView x:Name="TimelineList" Grid.Row="2"
                ItemTemplateSelector="{StaticResource TimelineSelector}"
                SelectionMode="None" ShowsScrollingPlaceholders="False" Holding="TimelineList_Holding"
                Padding="12,10,12,4">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
          </Style>
        </ListView.ItemContainerStyle>
      </ListView>

      <Button x:Name="LoadHistoryButton" Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="12,0" MinHeight="44" Visibility="Collapsed" Click="LoadHistory_Click" Background="{StaticResource ChromeBrush}" />
      <Button x:Name="ReturnToBottomButton" Grid.Row="2" Content="回到底部" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12" MinHeight="44" Visibility="Collapsed" Click="ReturnToBottom_Click" Background="{StaticResource ChromeBrush}" />
      <!-- 输入区 -->
      <StackPanel Grid.Row="3" Background="{StaticResource ChromeBrush}" Padding="10,8,10,10">

        <Border x:Name="ContextWarning" Visibility="Collapsed" Background="{StaticResource WarnSoftBrush}" Padding="10,6" Margin="0,0,0,7">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="ContextWarningText" Foreground="{StaticResource WarnTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
            <Button Grid.Column="1" Content="压缩" Style="{StaticResource OutlineButton}" Click="ContextWarning_Click" />
          </Grid>
        </Border>
        <TextBlock x:Name="OfflineHint" Text="没有网络。联网后再发送，输入内容会保留。" Visibility="Collapsed" Foreground="{StaticResource WarnTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,7" />
        <!-- 分支条：这条回复有多个候选时才出现。点箭头切换，不弹对话框 -->
        <Grid x:Name="BranchBar" Visibility="Collapsed" Margin="0,0,0,7">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Button Grid.Column="0" x:Name="BranchPrevButton" Style="{StaticResource IconButton}"
                  Content="&#xE76B;" FontSize="14" Click="BranchPrev_Click" />
          <TextBlock Grid.Column="1" x:Name="BranchText" Style="{StaticResource SubText}"
                     VerticalAlignment="Center" Margin="2,0,4,0" />
          <Button Grid.Column="2" x:Name="BranchNextButton" Style="{StaticResource IconButton}"
                  Content="&#xE76C;" FontSize="14" HorizontalAlignment="Left" Click="BranchNext_Click" />
        </Grid>

        <!-- 运行条：进度 + 状态 + 打断，独占一行，这样打断永远点得到 -->
        <Grid x:Name="RunBar" Visibility="Collapsed" Margin="0,0,0,7">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <ProgressRing Grid.Column="0" x:Name="RunRing" IsActive="True"
                        Width="18" Height="18" Foreground="{StaticResource AccentTextBrush}" />

          <TextBlock Grid.Column="1" x:Name="RunText" Text="正在生成"
                     Foreground="{StaticResource MidBrush}" FontSize="13"
                     VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" />

          <Button Grid.Column="2" x:Name="StopButton" Content="打断"
                  Background="Transparent" BorderBrush="{StaticResource ErrBrush}" BorderThickness="1"
                  Foreground="{StaticResource ErrTextBrush}" FontSize="13"
                  Height="32" Padding="12,0" Click="Stop_Click" />
        </Grid>

        <!-- 朗读条：正在朗读时显示，点一下停 -->
        <Grid x:Name="SpeechBar" Visibility="Collapsed" Margin="0,0,0,7">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="&#xE767;" FontFamily="{StaticResource IconFont}"
                     FontSize="14" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" x:Name="SpeechText" Style="{StaticResource SubText}"
                     VerticalAlignment="Center" Margin="8,0" />
          <Button Grid.Column="2" Content="停止朗读" Style="{StaticResource OutlineButton}"
                  Click="StopSpeech_Click" />
        </Grid>

        <!-- 附件提示（简易版只显示数量，不做缩略图） -->
        <TextBlock x:Name="AttachmentHint" Style="{StaticResource SubText}"
                   Visibility="Collapsed" Margin="0,0,0,6" />

        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"><ItemsControl x:Name="PendingAttachmentList" Margin="0,0,0,6"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer>
        <!-- 快捷消息：横向一条，不占竖向空间；手机上一行放得下三四个 -->
        <ScrollViewer x:Name="QuickBar" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                      Margin="0,0,0,6">
          <StackPanel x:Name="QuickBarPanel" Orientation="Horizontal" />
        </ScrollViewer>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button Grid.Column="0" x:Name="AttachButton" Style="{StaticResource IconButton}"
                  Content="&#xE723;" Click="Attach_Click" />

          <TextBox Grid.Column="1" x:Name="ComposerBox" Style="{StaticResource ComposerBox}"
                   PlaceholderText="发消息…" Margin="6,0" KeyDown="Composer_KeyDown" />

          <Button Grid.Column="2" x:Name="SendButton" Style="{StaticResource IconButton}"
                  Content="&#xE724;" Foreground="{StaticResource AccentTextBrush}" Click="Send_Click" />
        </Grid>
      </StackPanel>
    </Grid>
    <Frame x:Name="DetailFrame" Visibility="Collapsed" Background="{StaticResource BgBrush}" />
    <Frame x:Name="InteractionFrame" Visibility="Collapsed" Background="{StaticResource BgBrush}" />
  </Grid>
</Page>
