<Project Sdk="Microsoft.NET.Sdk">

  <!--
    桌面测试工程。
    两个作用：
      1) 让 Core 逻辑可以在桌面直接跑（不用每次部署到手机）；
      2) 用 LangVersion 7.3 编译，**任何 C# 7.3 之后的新语法都会在这里编译失败** ——
         这是防止不小心写出 UWP 编译不过的代码的第一道闸。
    只链接 src\Yanshuai.Messages\Core\**，不含 Platform / Ui。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>CoreTests</AssemblyName>
    <RootNamespace>Yanshuai.Messages.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0162</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**" />
    <Compile Include="..\..\src\Yanshuai.Messages\Core\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
