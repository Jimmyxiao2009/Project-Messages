<Project Sdk="Microsoft.NET.Sdk">

  <!--
    tools/SeedData —— 往一个工作区目录里塞演示数据。
    用途：验证 UWP 界面（真机或桌面上跑起来的应用）在**有数据**时的渲染，
    而不是每次都要手动点半天建档案、建会话。

    只链接 Core（与桌面测试同样的做法），所以不会引入任何 Windows.* 依赖。
    目标目录用命令行参数给，例如应用的真实 LocalState 路径。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>SeedData</AssemblyName>
    <RootNamespace>Yanshuai.Messages.Tools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0162</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**" />
    <Compile Include="..\..\src\Yanshuai.Messages\Core\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
