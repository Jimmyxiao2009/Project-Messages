<Application
    x:Class="Yanshuai.Messages.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--
          显式合并。旧项目的 Themes/AgentTheme.xaml 从头到尾没被合并过（是死代码），
          还带着语法错误 —— 这是"主题改了没反应"的根源。
          令牌与样式刻意放在同一个文件里，避免跨字典 StaticResource 解析失败。
        -->
        <ResourceDictionary Source="Themes/Design.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
