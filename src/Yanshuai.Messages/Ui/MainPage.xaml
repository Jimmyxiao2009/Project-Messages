<Page
    x:Class="Yanshuai.Messages.Ui.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Yanshuai.Messages.Ui"
    Background="{StaticResource BgBrush}">

  <!-- W10M 根 Pivot、虚拟化时间线与独立功能页导航。视觉对照 design/w10m。 -->

  <Page.Resources>

    <!-- ═══ 会话行：三行 + 左侧 4px 色条（设计稿 .row.bar） ═══ -->
    <DataTemplate x:Key="ConversationTemplate">
      <Grid MinHeight="{StaticResource RowHeight}">
        <Border Width="4" HorizontalAlignment="Left" Background="{Binding ToneBrush}" Margin="0,6" />

        <StackPanel Margin="12,8,12,8" VerticalAlignment="Center">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{StaticResource RowTitle}" />
            <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" Foreground="{StaticResource MidBrush}"
                       FontSize="{StaticResource FontSizeCaption}" Margin="12,2,0,0" VerticalAlignment="Top" />
          </Grid>
          <TextBlock Text="{Binding Preview}" Style="{StaticResource RowSubtitle}" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Border Background="{Binding BadgeBackground}" Visibility="{Binding BadgeVisibility}"
                    Height="18" Padding="6,0" Margin="0,0,8,0">
              <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeForeground}" FontSize="11"
                         VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="已完成" Visibility="{Binding PlainStatusVisibility}" Foreground="{StaticResource MidBrush}"
                       FontSize="{StaticResource FontSizeCaption}" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ProfileName}" Visibility="{Binding ProfileNameVisibility}"
                       Foreground="{StaticResource MidBrush}" FontSize="{StaticResource FontSizeCaption}"
                       MaxWidth="140" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TokenShort}" Visibility="{Binding TokenVisibility}"
                       Foreground="{StaticResource MidBrush}" FontFamily="{StaticResource MonoFont}"
                       FontSize="{StaticResource FontSizeCaption}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- ═══ 档案行：48 头像（强调色柔底）+ 两行 ═══ -->
    <DataTemplate x:Key="ProfileTemplate">
      <Grid MinHeight="64" Padding="12,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,12,0">
          <Ellipse Fill="{StaticResource AccentSoftBrush}" />
          <ui:WorkspaceImage SourcePath="{Binding AvatarPath}" Visibility="{Binding AvatarVisibility}" Stretch="UniformToFill" Circular="True" />
          <TextBlock Text="{Binding Initial}" Visibility="{Binding InitialVisibility}" Foreground="{StaticResource TextBrush}"
                     FontSize="20" FontWeight="SemiLight" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" />
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource RowSubtitle}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- ═══ 过程轨道里的一个步骤：10px 节点压在 2px 轨道上 ═══ -->
    <DataTemplate x:Key="StepTemplate">
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Width="10" Height="10" CornerRadius="{Binding NodeCornerRadius}"
                Background="{Binding NodeBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,5,0,0" />

        <StackPanel Grid.Column="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{StaticResource StepTitle}"
                       Foreground="{Binding TitleBrush}" FontStyle="{Binding TitleFontStyle}" />
            <TextBlock Grid.Column="1" Text="{Binding StatusGlyph}"
                       FontFamily="{StaticResource IconFont}" FontSize="11"
                       Foreground="{Binding StatusBrush}" Margin="8,4,0,0" VerticalAlignment="Top" />
          </Grid>
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource StepSub}"
                     Visibility="{Binding SubtitleVisibility}" />
          <Border Style="{StaticResource StepOutput}" Visibility="{Binding BodyVisibility}">
            <TextBlock Text="{Binding Body}" Style="{StaticResource StepBody}" />
          </Border>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- ═══ 时间线：用户消息（唯一靠右的气泡，右下小尾巴离右边 12） ═══ -->
    <DataTemplate x:Key="UserRowTemplate">
      <StackPanel Margin="0,2,0,18">
        <ui:AttachmentStrip Items="{Binding Attachments}" Visibility="{Binding AttachVisibility}" HorizontalAlignment="Right" Margin="40,0,0,6" />
        <Border Style="{StaticResource UserBubble}" Background="{Binding UserBrush}">
          <TextBlock Text="{Binding Text}" Style="{StaticResource UserBubbleText}" Foreground="{Binding UserForeground}" FontSize="{Binding FontSize}" LineHeight="{Binding LineHeight}" />
        </Border>
        <Polygon Fill="{Binding UserBrush}" Points="0,0 12,0 12,8" Width="12" Height="8" HorizontalAlignment="Right" Margin="0,-1,12,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,12,0" Visibility="{Binding ActionsVisibility}">
          <Button Style="{StaticResource BareButton}" Content="复制" FontSize="11" Foreground="{StaticResource MidBrush}" Padding="8,2" MinHeight="28" Click="BubbleCopy_Click" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <!-- ═══ 时间线：过程轨道 ═══ -->
    <DataTemplate x:Key="ProcessRowTemplate">
      <StackPanel Margin="0,0,0,14">
        <Button Style="{StaticResource BareButton}" MinHeight="32" Click="ProcessSummary_Click">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StateGlyph}"
                       FontFamily="{StaticResource IconFont}" FontSize="12"
                       Foreground="{Binding StateBrush}" HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="{StaticResource MidBrush}"
                       FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
          </Grid>
        </Button>

        <Grid Visibility="{Binding RailVisibility}" Margin="0,4,0,0">
          <Rectangle Width="2" HorizontalAlignment="Left" Margin="7,4,0,6" Fill="{Binding RailBrush}" Opacity="0.6" />
          <ItemsControl ItemsSource="{Binding StepItems}" ItemTemplate="{StaticResource StepTemplate}" />
        </Grid>
      </StackPanel>
    </DataTemplate>

    <!-- ═══ 时间线：最终输出（无气泡，正文） ═══ -->
    <DataTemplate x:Key="OutputRowTemplate">
      <StackPanel Margin="0,0,0,16">
        <RichTextBlock ui:MarkdownBlock.Text="{Binding Text}" ui:MarkdownBlock.QuoteColor="{Binding QuoteColor}" ui:MarkdownBlock.BracketColor="{Binding BracketColor}" Foreground="{StaticResource TextBrush}" FontSize="{Binding FontSize}" LineHeight="{Binding LineHeight}" IsTextSelectionEnabled="True" />
        <!-- 气泡操作行：复制 / 重试 / 分支。长按菜单仍然保留（更多操作在里面） -->
        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding ActionsVisibility}">
          <Button Style="{StaticResource BareButton}" Content="复制" FontSize="11" Foreground="{StaticResource MidBrush}" Padding="8,2" MinHeight="28" Click="BubbleCopy_Click" />
          <Button Style="{StaticResource BareButton}" Content="重试" FontSize="11" Foreground="{StaticResource MidBrush}" Padding="8,2" MinHeight="28" Click="BubbleRetry_Click" />
          <Button Style="{StaticResource BareButton}" Content="分支" FontSize="11" Foreground="{StaticResource MidBrush}" Padding="8,2" MinHeight="28" Click="BubbleBranch_Click" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <!-- ═══ 时间线：居中提示（ChromeLow 小胶囊） ═══ -->
    <DataTemplate x:Key="MarkerRowTemplate">
      <Border Background="{StaticResource ChromeLowBrush}" Padding="10,3" HorizontalAlignment="Center" Margin="0,2,0,16">
        <TextBlock Text="{Binding Text}" Foreground="{StaticResource MidBrush}" FontSize="{StaticResource FontSizeCaption}"
                   TextWrapping="Wrap" TextAlignment="Center" />
      </Border>
    </DataTemplate>

    <!-- ═══ 时间线：错误（2px 红色左边，不加底色） ═══ -->
    <DataTemplate x:Key="ErrorRowTemplate">
      <Border BorderBrush="{StaticResource ErrBrush}" BorderThickness="2,0,0,0" Padding="12,4,0,4" Margin="0,0,0,16">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xEA39;" FontFamily="{StaticResource IconFont}" FontSize="15"
                       Foreground="{StaticResource ErrTextBrush}" Margin="0,2,8,0" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{StaticResource ErrTextBrush}"
                       FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
          </Grid>
          <TextBlock Text="{Binding ErrorCode}" Style="{StaticResource SubText}" Margin="0,2,0,0"
                     Visibility="{Binding ErrorCodeVisibility}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <ui:TimelineTemplateSelector x:Key="TimelineSelector"
        UserTemplate="{StaticResource UserRowTemplate}"
        ProcessTemplate="{StaticResource ProcessRowTemplate}"
        OutputTemplate="{StaticResource OutputRowTemplate}"
        MarkerTemplate="{StaticResource MarkerRowTemplate}"
        ErrorTemplate="{StaticResource ErrorRowTemplate}" />

  </Page.Resources>

  <Grid>
    <!-- ═════════════════════ 首页 ═════════════════════ -->
    <Grid x:Name="HomeView">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Pivot 小标题：「言枢」+ 档案数，单行 -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,8,12,0">
        <TextBlock Text="言枢" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold"
                   CharacterSpacing="40" VerticalAlignment="Center" />
        <TextBlock x:Name="HomeSubtitle" Foreground="{StaticResource MidBrush}" FontSize="{StaticResource FontSizeCaption}"
                   Margin="8,0,0,0" VerticalAlignment="Center" />
      </StackPanel>

      <Pivot Grid.Row="1" x:Name="HomePivot" SelectionChanged="HomePivot_SelectionChanged"
             Loaded="HomePivot_Loaded" Background="{StaticResource BgBrush}">

        <!-- ─── 对话 ─── -->
        <PivotItem Header="对话">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchBox" Grid.Row="0" Visibility="Collapsed"
                     Margin="12,4,12,8" PlaceholderText="搜索会话"
                     Style="{StaticResource FieldBox}"
                     TextChanged="SearchBox_TextChanged" />

            <!-- 档案头像条：点一下就地筛选 -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
              <StackPanel x:Name="ProfileFilterPanel" Orientation="Horizontal" Margin="8,4,12,6" />
            </ScrollViewer>

            <ListView x:Name="ConversationList" Grid.Row="2"
                      ItemTemplate="{StaticResource ConversationTemplate}"
                      ItemContainerStyle="{StaticResource FlushListItem}"
                      IsItemClickEnabled="True" ItemClick="ConversationList_ItemClick"
                      SelectionMode="None" ShowsScrollingPlaceholders="False">
              <ListView.GroupStyle>
                <GroupStyle HeaderContainerStyle="{StaticResource PlainGroupHeader}">
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" Foreground="{Binding HeaderBrush}" />
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ListView.GroupStyle>
            </ListView>

            <StackPanel x:Name="EmptyConversations" Grid.Row="2" Visibility="Collapsed"
                        VerticalAlignment="Center" Margin="24,0,24,40">
              <Border Style="{StaticResource EmptyIconCircle}">
                <TextBlock x:Name="EmptyConversationsGlyph" Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="28"
                           Foreground="{StaticResource MidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock x:Name="EmptyConversationsTitle" Text="还没有会话" Style="{StaticResource EmptyTitle}" />
              <TextBlock x:Name="EmptyConversationsText" Text="点下面的「新建会话」开始。" Style="{StaticResource EmptyText}" />
            </StackPanel>
          </Grid>
        </PivotItem>

        <!-- ─── 档案 ─── -->
        <PivotItem Header="档案">
          <Grid>
            <ListView x:Name="ProfileList" ItemTemplate="{StaticResource ProfileTemplate}"
                      ItemContainerStyle="{StaticResource FlushListItem}"
                      IsItemClickEnabled="True" ItemClick="ProfileList_ItemClick"
                      SelectionMode="None" ShowsScrollingPlaceholders="False">
              <ListView.Header>
                <Button Style="{StaticResource BareButton}" Click="NewProfile_Click" Padding="12,8" MinHeight="64">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="48" Height="48" Margin="0,0,12,0">
                      <Ellipse Stroke="{StaticResource ControlBorderBrush}" StrokeThickness="2" StrokeDashArray="2,2" />
                      <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                 Foreground="{StaticResource MidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="新建档案" Style="{StaticResource RowTitle}" />
                      <TextBlock Text="空白、模板，或从角色卡导入" Style="{StaticResource RowSubtitle}" />
                    </StackPanel>
                  </Grid>
                </Button>
              </ListView.Header>
            </ListView>

            <StackPanel x:Name="EmptyProfiles" Visibility="Collapsed" VerticalAlignment="Center" Margin="24,80,24,40">
              <Border Style="{StaticResource EmptyIconCircle}">
                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="28"
                           Foreground="{StaticResource MidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="还没有档案" Style="{StaticResource EmptyTitle}" />
              <TextBlock Text="点上面的「新建档案」，或导入一张角色卡。" Style="{StaticResource EmptyText}" />
            </StackPanel>
          </Grid>
        </PivotItem>

        <!-- ─── 我的 ─── -->
        <PivotItem Header="我的">
          <ScrollViewer>
            <StackPanel Padding="0,0,0,24">
              <TextBlock Text="模型与能力" Style="{StaticResource SectionLabel}" Margin="12,6,12,6" />
              <ui:SettingRow x:Name="ModelsRow" Glyph="&#xE945;" Title="模型" Tag="models" Click="PageLink_Click" />
              <ui:SettingRow x:Name="ApiProfilesRow" Glyph="&#xE774;" Title="Provider" Click="ApiProfiles_Click" />
              <ui:SettingRow x:Name="SpeechRow" Glyph="&#xE767;" Title="朗读" Tag="speech" Click="PageLink_Click" />
              <ui:SettingRow x:Name="SearchRow" Glyph="&#xE721;" Title="联网搜索" Click="SearchSettings_Click" />
              <ui:SettingRow Glyph="&#xE90F;" Title="内置工具" Subtitle="文件、网页、日历、run_python 等" Tag="tools" Click="PageLink_Click" />
              <ui:SettingRow Glyph="&#xE71B;" Title="MCP 服务器" Tag="mcp" Click="PageLink_Click" />
              <ui:SettingRow Glyph="&#xEA80;" Title="技能" Tag="skills" Click="PageLink_Click" />
              <ui:SettingRow Glyph="&#xE8CC;" Title="本地包" Subtitle="Chronos 模块（编译一次，反复加载）" Tag="packages" Click="PageLink_Click" />
              <ui:SettingRow x:Name="PermissionsRow" Glyph="&#xE8D7;" Title="权限记录" Click="Permissions_Click" />
              <ui:SettingRow Glyph="&#xE8B7;" Title="授权目录" Subtitle="允许工具读写的文件夹" Tag="folders" Click="PageLink_Click" />

              <TextBlock Text="提示词与记忆" Style="{StaticResource SectionLabel}" />
              <ui:SettingRow Glyph="&#xE77B;" Title="用户人设" Subtitle="你在对话里的身份" Tag="user-personas" Click="PageLink_Click" />
              <ui:SettingRow Glyph="&#xE81C;" Title="全局记忆" Tag="memory" Click="PageLink_Click" />
              <ui:SettingRow Glyph="&#xE8F1;" Title="世界书" Tag="lorebooks" Click="PageLink_Click" />
              <ui:SettingRow Glyph="&#xE8A5;" Title="模式注入" Tag="injections" Click="PageLink_Click" />
              <ui:SettingRow x:Name="QuickMessagesRow" Glyph="&#xE8BD;" Title="快捷消息" Click="QuickMessages_Click" />
              <ui:SettingRow Glyph="&#xE943;" Title="正则转换器" Tag="regex" Click="PageLink_Click" />

              <TextBlock Text="外观与通用" Style="{StaticResource SectionLabel}" />
              <ui:SettingRow Glyph="&#xE713;" Title="通用设置" Subtitle="回车键、启动行为、历史加载" Tag="general" Click="PageLink_Click" />
              <ui:SettingRow Glyph="&#xE790;" Title="主题与强调色" Tag="appearance" Click="PageLink_Click" />
              <ui:SettingRow Glyph="&#xE8D2;" Title="文字与可读性" Subtitle="字号与行高" Tag="typography" Click="PageLink_Click" />

              <TextBlock Text="数据" Style="{StaticResource SectionLabel}" />
              <ui:SettingRow x:Name="StorageRow" Glyph="&#xEDA2;" Title="存储空间" Click="Storage_Click" />
              <ui:SettingRow Glyph="&#xE777;" Title="备份与恢复" Subtitle="打包成 zip 保存到设备，或从备份恢复" Click="Backup_Click" />
              <ui:SettingRow Glyph="&#xE8B5;" Title="数据导入与导出" Tag="data" Click="PageLink_Click" />
              <ui:SettingRow Glyph="&#xE74D;" Title="回收区" Subtitle="删除的档案与会话" Tag="trash" Click="PageLink_Click" />

              <TextBlock Text="关于" Style="{StaticResource SectionLabel}" />
              <ui:SettingRow Glyph="&#xEBE8;" Title="调试日志" Subtitle="不含密钥与正文，可复制" Click="DebugLog_Click" />
              <ui:SettingRow x:Name="AboutRow" Glyph="&#xE946;" Title="关于言枢" Click="About_Click" />
            </StackPanel>
          </ScrollViewer>
        </PivotItem>
      </Pivot>

      <!-- 底部命令区：只放 3 个，UWP 的 CommandBar 主命令不会自动溢流，超了会被裁掉 -->
      <CommandBar Grid.Row="2" Background="{StaticResource ChromeBrush}">
        <AppBarButton x:Name="NewConversationButton" Icon="Add" Label="新建会话" Click="NewConversation_Click" />
        <AppBarButton Icon="Import" Label="导入角色卡" Click="ImportCard_Click" />
        <AppBarButton Icon="Find" Label="搜索" Click="SearchToggle_Click" />
        <CommandBar.SecondaryCommands>
          <AppBarButton Icon="Contact" Label="新建档案" Click="NewProfile_Click" />
          <AppBarButton Label="批量管理" Tag="manage" Click="PageLink_Click" />
          <AppBarButton Label="已归档会话" Tag="archived" Click="PageLink_Click" />
        </CommandBar.SecondaryCommands>
      </CommandBar>
    </Grid>

    <!-- ═════════════════════ 会话页 ═════════════════════ -->
    <Grid x:Name="ChatView" Visibility="Collapsed" Background="{StaticResource BgBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ui:WorkspaceImage x:Name="ChatBackgroundImage" Grid.RowSpan="4" Stretch="UniformToFill" IsHitTestVisible="False" />

      <!-- 顶栏：48 高 Chrome 色块（会话页例外，省高度）；手机不画返回箭头 -->
      <Grid Grid.Row="0" Height="{StaticResource TopBarHeight}" Background="{StaticResource ChromeBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" x:Name="ChatBackButton" Style="{StaticResource BackGlyphButton}" Content="&#xE72B;"
                Height="{StaticResource TopBarHeight}" Click="ChatBack_Click" AutomationProperties.Name="返回" />

        <StackPanel Grid.Column="1" x:Name="ChatTitlePanel" VerticalAlignment="Center" Margin="0,0,4,0">
          <TextBlock x:Name="ChatTitle" Foreground="{StaticResource TextBrush}"
                     FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <Button Style="{StaticResource BareButton}" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                  Click="ChatModel_Click" AutomationProperties.Name="切换 Provider 与模型">
            <TextBlock x:Name="ChatSubtitle" Foreground="{StaticResource MidBrush}" FontSize="{StaticResource FontSizeCaption}"
                       TextTrimming="CharacterEllipsis" />
          </Button>
        </StackPanel>

        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE712;"
                Height="{StaticResource TopBarHeight}" Click="ChatMore_Click" AutomationProperties.Name="更多" />
      </Grid>

      <!-- 待处理条：审批与追问固定钉在这里，不进列表 -->
      <Border x:Name="NoticeBanner" Grid.Row="1" Visibility="Collapsed"
              Background="{StaticResource WarnSoftBrush}" BorderBrush="{StaticResource WarnBrush}"
              BorderThickness="4,0,0,0" Padding="12,8,8,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock x:Name="NoticeTitle" Text="等待你处理"
                       Foreground="{StaticResource WarnTextBrush}" FontSize="14" FontWeight="SemiBold" />
            <TextBlock x:Name="NoticeDetail" Foreground="{StaticResource SoftTextBrush}" FontSize="{StaticResource FontSizeCaption}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="1" Style="{StaticResource SmallAccentButton}" Content="处理"
                  Click="NoticeAction_Click" VerticalAlignment="Center" Margin="10,0,0,0" />
        </Grid>
      </Border>

      <!-- 时间线 -->
      <ListView x:Name="TimelineList" Grid.Row="2"
                ItemTemplateSelector="{StaticResource TimelineSelector}"
                ItemContainerStyle="{StaticResource FlushListItem}"
                SelectionMode="None" ShowsScrollingPlaceholders="False" Holding="TimelineList_Holding"
                Padding="12,12,12,4" />

      <Button x:Name="LoadHistoryButton" Grid.Row="2" Style="{StaticResource MarkerButton}" VerticalAlignment="Top"
              Margin="0,8,0,0" Visibility="Collapsed" Click="LoadHistory_Click" />
      <Button x:Name="ReturnToBottomButton" Grid.Row="2" Style="{StaticResource FabButton}" Content="&#xE70D;"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12"
              Visibility="Collapsed" Click="ReturnToBottom_Click" AutomationProperties.Name="回到底部" />

      <!-- 下方区：通栏状态条 → 快捷消息 → 输入行 -->
      <StackPanel Grid.Row="3" Background="{StaticResource ChromeBrush}">

        <!-- 上下文快满：警告条 -->
        <Border x:Name="ContextWarning" Visibility="Collapsed" Style="{StaticResource StripBorder}"
                Background="{StaticResource WarnSoftBrush}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="14"
                       Foreground="{StaticResource WarnTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" x:Name="ContextWarningText" Style="{StaticResource StripText}"
                       Foreground="{StaticResource WarnTextBrush}" />
            <Button Grid.Column="2" Content="压缩" Style="{StaticResource StripButton}"
                    Foreground="{StaticResource WarnTextBrush}" Click="ContextWarning_Click" />
          </Grid>
        </Border>

        <!-- 分支条：这条回复有多个候选时才出现。点箭头切换，不弹对话框 -->
        <Border x:Name="BranchBar" Visibility="Collapsed" Style="{StaticResource StripBorder}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" FontSize="15"
                       Foreground="{StaticResource MidBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" x:Name="BranchText" Style="{StaticResource StripText}" />
            <Button Grid.Column="2" x:Name="BranchPrevButton" Style="{StaticResource StripButton}"
                    FontFamily="{StaticResource IconFont}" FontSize="13" Content="&#xE76B;"
                    Click="BranchPrev_Click" AutomationProperties.Name="上一个候选" />
            <Button Grid.Column="3" x:Name="BranchNextButton" Style="{StaticResource StripButton}"
                    FontFamily="{StaticResource IconFont}" FontSize="13" Content="&#xE76C;"
                    Click="BranchNext_Click" AutomationProperties.Name="下一个候选" />
          </Grid>
        </Border>

        <!-- 运行条：进度 + 状态 + 打断，独占一行，这样打断永远点得到 -->
        <Border x:Name="RunBar" Visibility="Collapsed" Style="{StaticResource StripBorder}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressRing Grid.Column="0" x:Name="RunRing" IsActive="True"
                          Width="20" Height="20" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" x:Name="RunText" Text="正在生成" Style="{StaticResource StripText}" />
            <Button Grid.Column="2" x:Name="StopButton" Style="{StaticResource StripStopButton}" Click="Stop_Click"
                    AutomationProperties.Name="打断">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="打断" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- 朗读条：正在朗读时显示，点一下停 -->
        <Border x:Name="SpeechBar" Visibility="Collapsed" Style="{StaticResource StripBorder}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="15"
                       Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" x:Name="SpeechText" Style="{StaticResource StripText}" />
            <Button Grid.Column="2" Style="{StaticResource StripStopButton}" Click="StopSpeech_Click"
                    AutomationProperties.Name="停止朗读">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="停止" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- 回复建议：副手模型按上下文生成，点一下填进输入框；输入框有字时自动收起 -->
        <Grid x:Name="SuggestionBar" Visibility="Collapsed" Padding="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" Padding="12,0,0,0">
            <StackPanel x:Name="SuggestionPanel" Orientation="Horizontal" />
          </ScrollViewer>
          <Button Grid.Column="1" x:Name="SuggestionRefreshButton" Style="{StaticResource StripButton}"
                  FontFamily="{StaticResource IconFont}" FontSize="13" Height="30" Content="&#xE72C;"
                  Foreground="{StaticResource MidBrush}" Click="SuggestionRefresh_Click" AutomationProperties.Name="换一批建议" />
        </Grid>

        <!-- 待发附件 -->
        <ScrollViewer x:Name="PendingAttachmentBar" Visibility="Collapsed"
                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" Padding="12,8,12,0">
          <ItemsControl x:Name="PendingAttachmentList">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>

        <!-- 输入行：附件 48 · 输入框 · 发送 52 -->
        <Grid Margin="0,8,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- 「+」面板：附件 / 权限审批（三档）/ 模型与 Effort。原先这三样散落在
               附件页、溢出菜单和档案页里，现在收在输入框旁边一步可达。 -->
          <Button Grid.Column="0" x:Name="AttachButton" Style="{StaticResource IconButton}" FontSize="18"
                  Content="&#xE710;" VerticalAlignment="Bottom" AutomationProperties.Name="更多操作">
            <Button.Flyout>
              <Flyout x:Name="ComposerFlyout" Placement="Top" Opened="ComposerFlyout_Opened">
                <StackPanel Width="272" Margin="0,4,0,0">
                  <TextBlock Text="附件" Style="{StaticResource StepTitle}" />
                  <Button Style="{StaticResource BareButton}" Content="从工作区选择文件…" HorizontalContentAlignment="Left"
                          Margin="0,2,0,0" Click="PanelAttach_Click" />

                  <TextBlock Text="权限审批（本次会话）" Style="{StaticResource StepTitle}" Margin="0,12,0,0" />
                  <RadioButton x:Name="PermView" GroupName="ComposerPerm" Content="仅可查看" Tag="0"
                               Checked="ComposerPerm_Checked" />
                  <RadioButton x:Name="PermWorkspace" GroupName="ComposerPerm" Content="工作区内修改" Tag="1"
                               Checked="ComposerPerm_Checked" />
                  <RadioButton x:Name="PermFull" GroupName="ComposerPerm" Content="完全访问" Tag="2"
                               Checked="ComposerPerm_Checked" />

                  <TextBlock Text="模型与 Effort" Style="{StaticResource StepTitle}" Margin="0,12,0,0" />
                  <Button x:Name="PanelModelButton" Style="{StaticResource BareButton}" HorizontalContentAlignment="Left"
                          HorizontalAlignment="Stretch" Click="PanelModel_Click">
                    <StackPanel>
                      <TextBlock x:Name="PanelModelName" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                      <TextBlock Text="点我切换模型" FontSize="11" Foreground="{StaticResource MidBrush}" />
                    </StackPanel>
                  </Button>
                  <ComboBox x:Name="EffortBox" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                            SelectionChanged="EffortBox_Changed">
                    <ComboBoxItem Content="Effort：自动" Tag="auto" />
                    <ComboBoxItem Content="Effort：低" Tag="low" />
                    <ComboBoxItem Content="Effort：中" Tag="medium" />
                    <ComboBoxItem Content="Effort：高" Tag="high" />
                  </ComboBox>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <TextBox Grid.Column="1" x:Name="ComposerBox" Style="{StaticResource ComposerBox}"
                   PlaceholderText="发消息…" KeyDown="Composer_KeyDown" TextChanged="Composer_TextChanged" />

          <Button Grid.Column="2" x:Name="SendButton" Style="{StaticResource IconButton}" Width="52" FontSize="18"
                  Content="&#xE724;" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Bottom"
                  Click="Send_Click" AutomationProperties.Name="发送" />
        </Grid>

        <TextBlock x:Name="OfflineHint" Text="没有网络。联网后再发送，输入内容会保留。" Visibility="Collapsed"
                   Foreground="{StaticResource WarnTextBrush}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeCaption}"
                   Margin="48,0,12,8" />
      </StackPanel>
    </Grid>
    <Frame x:Name="DetailFrame" Visibility="Collapsed" Background="{StaticResource BgBrush}" />
    <Frame x:Name="InteractionFrame" Visibility="Collapsed" Background="{StaticResource BgBrush}" />
  </Grid>
</Page>
