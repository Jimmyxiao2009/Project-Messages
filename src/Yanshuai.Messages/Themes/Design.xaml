<!--
  Themes/Design.xaml —— 设计令牌 + 控件样式（刻意放在同一个文件里）

  为什么要合并：UWP 里一个合并字典用 StaticResource 去引用另一个合并字典的键，
  解析时机很微妙，运行期可能直接报"找不到资源"。合并成一个文件从根上避免这类问题。

  规矩：页面里不许出现硬编码色值，一律用这里的键。
  旧项目把 #1A1A1A 写死在页面里，切浅色主题时顶栏还是黑条 —— 这里从源头堵住。

  强调色三支画刷（AccentBrush / AccentTextBrush / AccentSoftBrush）在启动后由
  Ui/ThemeHelper.ApplyAccent 改写颜色：Windows 10 Mobile 上取不到 AccentLight1/2/3，
  浅色阶必须自己算。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════ 颜色 ═══════════════ -->

  <!-- 底色与层次 -->
  <SolidColorBrush x:Key="BgBrush"          Color="#000000" />
  <SolidColorBrush x:Key="ChromeBrush"      Color="#1F1F1F" />
  <SolidColorBrush x:Key="ChromeLowBrush"   Color="#171717" />
  <SolidColorBrush x:Key="ChromeMidBrush"   Color="#2B2B2B" />
  <SolidColorBrush x:Key="LowBrush"         Color="#333333" />
  <SolidColorBrush x:Key="CodeBrush"        Color="#0C0C0C" />

  <!-- 文字 -->
  <SolidColorBrush x:Key="TextBrush"        Color="#FFFFFF" />
  <SolidColorBrush x:Key="SoftTextBrush"    Color="#BDBDBD" />
  <SolidColorBrush x:Key="MidBrush"         Color="#999999" />
  <SolidColorBrush x:Key="FaintBrush"       Color="#666666" />

  <!-- 强调色（启动后按系统强调色替换） -->
  <SolidColorBrush x:Key="AccentBrush"      Color="#0078D7" />
  <SolidColorBrush x:Key="AccentTextBrush"  Color="#76B9ED" />
  <SolidColorBrush x:Key="AccentSoftBrush"  Color="#590078D7" />
  <SolidColorBrush x:Key="OnAccentBrush"    Color="#FFFFFF" />

  <!-- 语义色 -->
  <SolidColorBrush x:Key="ThinkBrush"       Color="#B4A0FF" />
  <SolidColorBrush x:Key="ThinkBorderBrush" Color="#8764B8" />
  <SolidColorBrush x:Key="WarnTextBrush" Color="#FFB900" />
  <SolidColorBrush x:Key="WarnBrush"        Color="#FFB900" />
  <SolidColorBrush x:Key="WarnSoftBrush"    Color="#24FFB900" />
  <SolidColorBrush x:Key="ErrBrush"         Color="#E81123" />
  <SolidColorBrush x:Key="ErrTextBrush"     Color="#FF99A4" />
  <SolidColorBrush x:Key="ErrSoftBrush"     Color="#29E81123" />
  <SolidColorBrush x:Key="OkBrush"          Color="#6CCB5F" />

  <!--
    控件底与边（W10 BaseLow / BaseMediumLow）。
    设计稿 design/w10m/index.html 令牌对照表标注"建议新增"；浅色值由 ThemeHelper 覆写。
    没有这几支的话，页面里的按钮 / 输入框只能落到系统默认灰色，
    也就是截图里那一堆 #6E6E6E / #3F3F3F / #7C7C7C 的来源。
  -->
  <SolidColorBrush x:Key="ControlFillBrush"        Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#66FFFFFF" />
  <SolidColorBrush x:Key="ControlBorderBrush"      Color="#66FFFFFF" />
  <SolidColorBrush x:Key="ControlBorderHoverBrush"  Color="#99FFFFFF" />

  <!-- 输入框：静止底 / 聚焦白底黑字（设计稿"TextBox 2px 边框，聚焦白底黑字 + 强调色边"） -->
  <SolidColorBrush x:Key="FieldBrush"              Color="#66000000" />
  <SolidColorBrush x:Key="FocusFieldBrush"         Color="#FFFFFF" />
  <SolidColorBrush x:Key="FocusFieldTextBrush"     Color="#000000" />

  <!-- 弹层遮罩 / 更高一层的 chrome -->
  <SolidColorBrush x:Key="OverlayBrush"            Color="#99000000" />
  <SolidColorBrush x:Key="ChromeHighBrush"         Color="#767676" />

  <!-- Markdown 着色：引号与括号（档案外观可覆盖） -->
  <SolidColorBrush x:Key="QuoteBrush"              Color="#DCA03C" />
  <SolidColorBrush x:Key="BracketBrush"            Color="#969696" />

  <!-- ═══════════════ 字体与刻度 ═══════════════ -->

  <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="MonoFont">Consolas</FontFamily>

  <x:Double x:Key="FontSizeCaption">12</x:Double>
  <x:Double x:Key="FontSizeBody">15</x:Double>
  <x:Double x:Key="FontSizeUi">15</x:Double>
  <x:Double x:Key="FontSizeSubtitle">20</x:Double>
  <x:Double x:Key="FontSizeTitle">24</x:Double>
  <x:Double x:Key="FontSizeHeader">34</x:Double>

  <x:Double x:Key="RowHeight">56</x:Double>
  <x:Double x:Key="TouchTargetHeight">44</x:Double>
  <x:Double x:Key="IconButtonWidth">48</x:Double>
  <x:Double x:Key="IconButtonHeight">40</x:Double>
  <x:Double x:Key="TopBarHeight">48</x:Double>

  <Thickness x:Key="PagePadding">12</Thickness>
  <Thickness x:Key="RowPadding">12,8</Thickness>
  <Thickness x:Key="CardPadding">12,14</Thickness>

  <CornerRadius x:Key="CardCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>

  <!-- ═══════════════ 文字样式 ═══════════════ -->

  <Style x:Key="MutedText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MidBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SubText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MidBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="BodyText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="22" />
  </Style>

  <Style x:Key="SectionLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MidBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="80" />
    <Setter Property="Margin" Value="12,18,12,6" />
  </Style>

  <!-- 列表行标题 15 Regular / 副标题 12 Mid 单行（设计稿 .row .c > b / small） -->
  <Style x:Key="RowTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <Style x:Key="RowSubtitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MidBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="Margin" Value="0,1,0,0" />
  </Style>

  <!-- 子页上标签：12 SemiBold，所属档案 / 上级 -->
  <Style x:Key="PageOverline" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MidBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="50" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiLight" />
    <Setter Property="LineHeight" Value="32" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <Style x:Key="TitleText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="Light" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="Glyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ═══════════════ 按钮 ═══════════════ -->

  <!-- 悬停 / 按下时叠一层很淡的底，浅色主题由 ThemeHelper 覆写 -->
  <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="PressedBrush" Color="#26FFFFFF" />

  <!--
    W10M 按钮反馈：按下整块微微倾斜（PointerDownThemeAnimation），叠一层淡底；不画系统那块灰底灰边。
    系统模板在新版 Windows 上悬停是一块 #3F3F3F 方块，圆形头像、整行列表都会被它盖住，非常难看。
    所有自定义按钮样式共用这一个模板；直角、无圆角（14393 的 Control 没有 CornerRadius）。
  -->
  <ControlTemplate x:Key="TiltButtonTemplate" TargetType="Button">
    <Border x:Name="Root" Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal">
            <Storyboard><PointerUpThemeAnimation Storyboard.TargetName="Root" /></Storyboard>
          </VisualState>
          <VisualState x:Name="PointerOver">
            <Storyboard>
              <PointerUpThemeAnimation Storyboard.TargetName="Root" />
              <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
            </Storyboard>
          </VisualState>
          <VisualState x:Name="Pressed">
            <Storyboard>
              <PointerDownThemeAnimation Storyboard.TargetName="Root" />
              <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
            </Storyboard>
          </VisualState>
          <VisualState x:Name="Disabled">
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
            </Storyboard>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Grid>
        <Rectangle x:Name="Hover" Fill="{StaticResource HoverBrush}" Opacity="0" IsHitTestVisible="False" />
        <Rectangle x:Name="Press" Fill="{StaticResource PressedBrush}" Opacity="0" IsHitTestVisible="False" />
        <ContentPresenter x:Name="ContentPresenter"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          ContentTransitions="{TemplateBinding ContentTransitions}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          Foreground="{TemplateBinding Foreground}"
                          FontFamily="{TemplateBinding FontFamily}"
                          FontSize="{TemplateBinding FontSize}"
                          FontWeight="{TemplateBinding FontWeight}" />
      </Grid>
    </Border>
  </ControlTemplate>

  <Style x:Key="TiltButton" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource TiltButtonTemplate}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
  </Style>

  <!--
    列表行：整行可点，左右各 12 内边距；两行内容的行自然高于 44，MinHeight 只是下限。
  -->
  <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource TiltButton}">
    <Setter Property="Padding" Value="{StaticResource RowPadding}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="{StaticResource TouchTargetHeight}" />
  </Style>

  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource TiltButton}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="{StaticResource IconButtonWidth}" />
    <Setter Property="Height" Value="{StaticResource IconButtonHeight}" />
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource TiltButton}">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Height" Value="{StaticResource IconButtonHeight}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
  </Style>

  <!-- 筛选芯片：ControlFill 底；选中态用强调色描边（设计稿 home-filtered：选中档案加强调色描边） -->
  <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource TiltButton}">
    <Setter Property="Background" Value="{StaticResource ControlFillBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="{StaticResource TouchTargetHeight}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!--
    表单输入框：同样只留排版与尺寸，不覆写系统 chrome。
    Header 用系统属性，聚焦态交给系统模板。
  -->
  <Style x:Key="FieldBox" TargetType="TextBox">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="MinHeight" Value="{StaticResource TouchTargetHeight}" />
    <Setter Property="Padding" Value="10,8" />
  </Style>

  <!-- 无 chrome 的按钮：头像、轨道摘要这类"整块可点"的内容 -->
  <Style x:Key="BareButton" TargetType="Button" BasedOn="{StaticResource TiltButton}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>

  <!-- 子页 / 会话页的页内返回（只在桌面显示；手机走系统返回键） -->
  <Style x:Key="BackGlyphButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="FontSize" Value="16" />
  </Style>

  <!-- 页头右侧的文字动作（键盘弹出时的「保存」） -->
  <Style x:Key="HeaderTextButton" TargetType="Button" BasedOn="{StaticResource TiltButton}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="Height" Value="{StaticResource IconButtonHeight}" />
    <Setter Property="Padding" Value="12,0" />
  </Style>

  <!-- 小号主按钮：待处理条里的「处理」 -->
  <Style x:Key="SmallAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- 快捷消息芯片：30 高、ControlFill 实底、无边框（设计稿 .qbar span） -->
  <Style x:Key="QuickChipButton" TargetType="Button" BasedOn="{StaticResource TiltButton}">
    <Setter Property="Background" Value="{StaticResource ControlFillBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <!-- 待发附件芯片：ChromeMid 底、28 高（设计稿 .attc） -->
  <Style x:Key="AttachChipButton" TargetType="Button" BasedOn="{StaticResource TiltButton}">
    <Setter Property="Background" Value="{StaticResource ChromeMidBrush}" />
    <Setter Property="Foreground" Value="{StaticResource SoftTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MaxWidth" Value="220" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <!-- 会话页下方各条（分支 / 运行 / 朗读）：通栏 ChromeLow、40 高（设计稿 .strip） -->
  <Style x:Key="StripBorder" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource ChromeLowBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BgBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,0,4,0" />
  </Style>

  <Style x:Key="StripText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SoftTextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <Style x:Key="StripButton" TargetType="Button" BasedOn="{StaticResource TiltButton}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Height" Value="40" />
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,0" />
  </Style>

  <Style x:Key="StripStopButton" TargetType="Button" BasedOn="{StaticResource StripButton}">
    <Setter Property="Foreground" Value="{StaticResource ErrTextBrush}" />
  </Style>

  <!-- 时间线居中提示 / 加载更早消息：ChromeLow 小胶囊（设计稿 .mk span） -->
  <Style x:Key="MarkerButton" TargetType="Button" BasedOn="{StaticResource TiltButton}">
    <Setter Property="Background" Value="{StaticResource ChromeLowBrush}" />
    <Setter Property="Foreground" Value="{StaticResource MidBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- 回到底部：40×40 ChromeMid 方块 + 1px Low 描边（设计稿 .fab） -->
  <Style x:Key="FabButton" TargetType="Button" BasedOn="{StaticResource TiltButton}">
    <Setter Property="Background" Value="{StaticResource ChromeMidBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LowBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource TiltButton}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LowBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinWidth" Value="88" />
    <Setter Property="Height" Value="{StaticResource IconButtonHeight}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
  </Style>

  <!-- ═══════════════ Pivot（W10M 15254 形态） ═══════════════ -->

  <!--
    选中头 Text、未选中 Mid、24 SemiLight、无下划线。
    新版 Windows 的系统 Pivot 模板带一条选中下划线，手机 15254 没有；
    这里只换 PivotHeaderItem 模板，Pivot 本身仍是系统控件（轮转、滑动都保留）。
  -->
  <Style TargetType="PivotHeaderItem">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiLight" />
    <Setter Property="Foreground" Value="{StaticResource MidBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <!-- 左 12 对齐页边；与下一项的左 12 合起来，头之间间隔 20 -->
    <Setter Property="Padding" Value="12,0,8,0" />
    <Setter Property="Height" Value="46" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PivotHeaderItem">
          <Grid Background="{TemplateBinding Background}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Disabled" />
                <VisualState x:Name="Unselected" />
                <VisualState x:Name="UnselectedLocked" />
                <VisualState x:Name="Selected">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TextBrush}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="UnselectedPointerOver">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SoftTextBrush}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="SelectedPointerOver">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TextBrush}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="UnselectedPressed">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SoftTextBrush}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="SelectedPressed">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TextBrush}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Margin="{TemplateBinding Padding}"
                              FontSize="{TemplateBinding FontSize}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontWeight="{TemplateBinding FontWeight}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 列表要贴边（4px 状态条在屏幕最左），页边距由行自己给 -->
  <Style TargetType="PivotItem">
    <Setter Property="Margin" Value="0" />
  </Style>

  <!-- 分组头：去掉系统 ListViewHeaderItem 的分隔线与缩进，只留文字 -->
  <Style x:Key="PlainGroupHeader" TargetType="ListViewHeaderItem">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewHeaderItem">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 贴边列表项：无内边距、无最小高度 -->
  <Style x:Key="FlushListItem" TargetType="ListViewItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!-- ═══════════════ 空态 ═══════════════ -->

  <Style x:Key="EmptyIconCircle" TargetType="Border">
    <Setter Property="Width" Value="72" />
    <Setter Property="Height" Value="72" />
    <Setter Property="CornerRadius" Value="36" />
    <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,0,0,18" />
  </Style>

  <Style x:Key="EmptyTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style x:Key="EmptyText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MidBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="22" />
  </Style>

  <!-- ═══════════════ 容器 ═══════════════ -->

  <Style x:Key="CardBorder" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource ChromeMidBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LowBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    <Setter Property="Margin" Value="14,0,14,10" />
    <Setter Property="Padding" Value="{StaticResource CardPadding}" />
  </Style>

  <Style x:Key="UserBubble" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Padding" Value="11,8" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="MaxWidth" Value="420" />
    <Setter Property="Margin" Value="40,0,0,0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

  <Style x:Key="UserBubbleText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="IsTextSelectionEnabled" Value="True" />
  </Style>

  <Style x:Key="RailBorder" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="10,2,0,2" />
    <Setter Property="Margin" Value="0,2,0,8" />
  </Style>

  <Style x:Key="StepTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- 工具输出框：ChromeLow 底 + 2px Low 左边（设计稿 .st .out） -->
  <Style x:Key="StepOutput" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource ChromeLowBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LowBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>

  <Style x:Key="StepSub" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MidBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <!--
    思考/工具输出的正文。**不要加 MaxHeight**：之前钉了 220px，真机上长思考
    直接被裁掉一截（用户报"思考内容被遮住"），而 ListView 行内套滚动器在手机上
    手势很别扭。工具输出在 AgentRunner 里已有 ToolOutputChars 截断，这里不再二次截。
  -->
  <Style x:Key="StepBody" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SoftTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="18" />
  </Style>

  <Style x:Key="ThinkingText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource ThinkBrush}" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxLines" Value="2" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!--
    输入框：只留排版与尺寸，**不碰 Background / BorderBrush / BorderThickness**。
    原实现用 ChromeMid 底 + BorderThickness=0 把系统 TextBox 的边框整个抹掉了，
    结果是聚焦时没有任何可见反馈 —— 这是可交互性缺陷，不是风格选择。
    交还系统模板后，W10 的 TextBox 自带"聚焦白底黑字 + 强调色边"，
    也就是 design/w10m 令牌表里写的那三条，但由平台提供、随主题走、不用自己维护。
  -->
  <Style x:Key="ComposerBox" TargetType="TextBox">
    <Setter Property="FontSize" Value="{StaticResource FontSizeUi}" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="MaxHeight" Value="140" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

</ResourceDictionary>
